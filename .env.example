# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only — never expose to the browser

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=                # any random string; same value goes in the Meta webhook settings
WHATSAPP_APP_SECRET=                  # Meta app secret, used to verify X-Hub-Signature-256
WHATSAPP_ACCESS_TOKEN=                # dev/pilot only; production tokens live in Supabase Vault per shop
WHATSAPP_API_VERSION=v23.0

# Login codes over WhatsApp (optional). In Supabase: Authentication → Hooks → Send SMS hook (HTTPS)
#   URL: https://<your-domain>/api/auth/whatsapp-otp   — paste the generated secret below.
# Needs an approved "authentication" template on the Morekisi platform number.
MOREKISI_PLATFORM_PHONE_NUMBER_ID=
WHATSAPP_LOGIN_TEMPLATE=morekisi_login_code
WHATSAPP_LOGIN_TEMPLATE_LANG=en
SUPABASE_SEND_SMS_HOOK_SECRET=        # "v1,whsec_..."
